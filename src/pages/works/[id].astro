---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { seriesByCode, UNTITLED_NOTE } from '../../data/series';
import exhibitions from '../../data/exhibitions.json';
import { altText, getWorks, sizeText, workUrl, type Work } from '../../lib/works';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((w) => {
    const same = works.filter((x) => x.data.series === w.data.series);
    const i = same.indexOf(w);
    return {
      params: { id: w.id },
      props: { work: w, prev: same[i - 1], next: same[i + 1] },
    };
  });
}

interface Props {
  work: Work;
  prev?: Work;
  next?: Work;
}

const { work, prev, next } = Astro.props;
const d = work.data;
const s = seriesByCode(d.series);
const size = sizeText(work);
const shows = d.exhibitions
  .map((id) => exhibitions.find((e) => e.id === id))
  .filter((e): e is (typeof exhibitions)[number] => !!e)
  .sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
---

<Base title={d.title_ko} description={[d.title_ko, d.title_en, d.year].filter(Boolean).join(' · ')}>
  <article class="wrap work">
    <figure class="view">
      <a href={d.image.src} title="원본 크기로 보기">
        <Image
          src={d.image}
          alt={altText(work)}
          widths={[800, 1200, 1600, 2000]}
          sizes="(max-width: 900px) 100vw, 66vw"
          priority
        />
      </a>
    </figure>

    <div class="caption">
      <h1>{d.title_ko}</h1>
      {d.title_en && <p class="en title-en">{d.title_en}</p>}
      {
        d.series === 'U' && (
          <p class="untitled-note">
            {UNTITLED_NOTE} <a href={`/works/series/${s.slug}/`}>제목 미상 그림 모두 보기</a>
          </p>
        )
      }

      <dl>
        {
          d.year && (
            <>
              <dt>연도</dt>
              <dd>{d.year}</dd>
            </>
          )
        }
        {
          d.medium_ko && (
            <>
              <dt>재료</dt>
              <dd>
                {d.medium_ko}
                {d.medium_en && <span class="en block">{d.medium_en}</span>}
              </dd>
            </>
          )
        }
        {
          size && (
            <>
              <dt>크기</dt>
              <dd>{size}</dd>
            </>
          )
        }
        {
          d.series !== 'U' && (
            <>
              <dt>연작</dt>
              <dd><a href={`/works/series/${s.slug}/`}>{s.ko}</a></dd>
            </>
          )
        }
      </dl>

      {
        shows.length > 0 && (
          <section class="shows">
            <h2>전시</h2>
            <ul>
              {shows.map((e) => (
                <li>
                  {e.year && <span class="muted">{e.year}</span>} {e.name}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {d.status === 'draft' && <p class="draft">검수 전 정보</p>}

      <nav class="pager" aria-label="같은 연작의 앞뒤 작품">
        {prev ? <a href={workUrl(prev)}>← {prev.data.title_ko}</a> : <span />}
        {next ? <a href={workUrl(next)}>{next.data.title_ko} →</a> : <span />}
      </nav>
    </div>
  </article>
</Base>

<style>
  .work {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
    padding-top: 32px;
  }

  .view {
    margin: 0;
    background: var(--tile);
    display: grid;
    place-items: center;
    padding: clamp(16px, 4vw, 48px);
    min-height: 50vh;
  }

  .view :global(img) {
    max-height: 78vh;
    width: auto;
    object-fit: contain;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
    cursor: zoom-in;
  }

  .caption h1 {
    font-size: 1.6rem;
  }

  .title-en {
    margin: 4px 0 0;
  }

  .untitled-note {
    margin: 8px 0 0;
    font-size: 0.88rem;
    color: var(--muted);
  }

  dl {
    display: grid;
    grid-template-columns: 3.5em 1fr;
    gap: 8px 12px;
    margin: 28px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  .block {
    display: block;
  }

  .shows {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .shows h2 {
    font-size: 1rem;
    margin-bottom: 8px;
  }

  .shows ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shows li + li {
    margin-top: 6px;
  }

  .draft {
    display: inline-block;
    margin: 24px 0 0;
    padding: 2px 8px;
    border: 1px solid #d9c3ad;
    color: #8a6440;
    font-size: 0.8rem;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .work {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 8px;
    }

    .view {
      min-height: 0;
      margin: 0 calc(var(--gutter) * -1);
    }

    .view :global(img) {
      max-height: 70vh;
    }
  }
</style>
