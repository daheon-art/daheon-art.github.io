---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { ARTIST, FEATURED } from '../data/site';
import { SERIES } from '../data/series';
import { altText, getWorks, sizeText, workUrl, yearRange } from '../lib/works';

const works = await getWorks();
const featured = works.find((w) => w.id === FEATURED) ?? works[0];

const series = SERIES.filter((s) => !s.hideOnHome).map((s) => {
  const list = works.filter((w) => w.data.series === s.code);
  const cover = list.find((w) => w.id === s.cover) ?? list[0];
  return { s, list, cover };
}).filter((x) => x.list.length);
---

<Base>
  <section class="wrap hero">
    <div class="intro">
      <h1>
        <span class="nw">{ARTIST.ho}</span> <span class="nw">{ARTIST.ko}</span>
        <span class="hanja">{ARTIST.hoHanja} {ARTIST.hanja}</span>
      </h1>
      <p class="en-name">{ARTIST.en}</p>
      <p class="lead">한국화</p>
      <p class="links">
        <a href="/works/">작품 {works.length}점 보기 →</a>
      </p>
    </div>
    <figure class="feature">
      <a href={workUrl(featured)}>
        <Image
          src={featured.data.image}
          alt={altText(featured)}
          widths={[800, 1200, 1600, 2000]}
          sizes="(max-width: 900px) 100vw, 60vw"
          priority
        />
      </a>
      <figcaption>
        <a href={workUrl(featured)}>{featured.data.title_ko}</a>
        <span class="muted">
          {[featured.data.year, featured.data.medium_ko, sizeText(featured)].filter(Boolean).join(', ')}
        </span>
      </figcaption>
    </figure>
  </section>

  <section class="wrap series">
    <h2>연작</h2>
    <ul>
      {
        series.map(({ s, list, cover }) => (
          <li>
            <a href={`/works/series/${s.slug}/`}>
              <div class="cover">
                <Image src={cover.data.image} alt="" widths={[320, 480, 640]} sizes="(max-width: 700px) 45vw, 220px" />
              </div>
              <p class="name">{s.ko}</p>
              <p class="en">{s.en}</p>
              <p class="meta">
                {yearRange(list)} · {list.length}점
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(0, 2fr);
    gap: 48px;
    align-items: center;
    padding-top: 40px;
    padding-bottom: 72px;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: 0.1em;
  }

  .nw {
    white-space: nowrap;
  }

  .hanja {
    display: block;
    font-size: 0.45em;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0.3em;
    margin-top: 6px;
  }

  .en-name {
    margin: 18px 0 0;
    color: var(--muted);
    letter-spacing: 0.06em;
  }

  .lead {
    margin: 4px 0 0;
    color: var(--muted);
  }

  .links {
    margin: 32px 0 0;
  }

  .links a {
    border-bottom: 1px solid var(--fg);
    padding-bottom: 2px;
  }

  .feature {
    margin: 0;
  }

  .feature > a {
    display: grid;
    place-items: center;
    background: var(--tile);
    padding: clamp(16px, 4vw, 48px);
  }

  .feature :global(img) {
    max-height: 70vh;
    width: auto;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 10px;
    font-size: 0.88rem;
  }

  .series h2 {
    font-size: 1.35rem;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    margin-bottom: 24px;
  }

  .series ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 32px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cover {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--tile);
  }

  .cover :global(img) {
    position: absolute;
    inset: 8%;
    width: 84%;
    height: 84%;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.18));
  }

  .name {
    margin: 12px 0 0;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .series .en,
  .meta {
    margin: 0;
    font-size: 0.85rem;
  }

  .meta {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 16px;
    }

    .feature > a {
      margin: 0 calc(var(--gutter) * -1);
    }
  }

  @media (max-width: 520px) {
    .series ul {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 14px;
    }
  }
</style>
