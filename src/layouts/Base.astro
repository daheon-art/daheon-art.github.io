---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ARTIST, FEATURED, SHOW_DRAFT_NOTICE } from '../data/site';
import { altText, getWorks } from '../lib/works';
import { DEFAULT_DESCRIPTION, SITE_NAME } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  // 카카오톡·페이스북 등에 주소를 붙였을 때 보이는 미리보기 그림. 비우면 대표 작품(FEATURED)
  image?: ImageMetadata;
  imageAlt?: string;
  // 구조화 데이터(JSON-LD). src/lib/seo.ts 에서 만든다
  jsonLd?: object;
  // 검색 결과에 넣지 않을 쪽 (404)
  noindex?: boolean;
}

const { title, description = DEFAULT_DESCRIPTION, jsonLd, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${ARTIST.ko}` : SITE_NAME;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;

let { image, imageAlt } = Astro.props;
if (!image) {
  const works = await getWorks();
  const featured = works.find((w) => w.id === FEATURED) ?? works[0];
  image = featured.data.image;
  imageAlt = altText(featured, true);
}
const og = await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 });
const ogImage = new URL(og.src, Astro.site).href;
const ld = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');

const nav = [
  { href: '/works/', label: '작품' },
  { href: '/about/', label: '작가' },
  { href: '/exhibitions/', label: '전시' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600&display=swap"
    />
  </head>
  <body>
    {
      SHOW_DRAFT_NOTICE && (
        <p class="notice">준비 중인 사이트입니다. 작품 정보를 계속 업데이트할 예정입니다.</p>
      )
    }
    <header class="site-header wrap">
      <a class="brand" href="/">
        <span class="brand-ko">{ARTIST.ko}</span>
        <span class="brand-hanja">{ARTIST.hanja}</span>
      </a>
      <nav aria-label="주 메뉴">
        {
          nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
              {n.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>© {ARTIST.ko} {ARTIST.en}. 이미지와 글을 무단으로 쓰지 마십시오.</p>
    </footer>
  </body>
</html>

<style>
  .notice {
    margin: 0;
    padding: 8px var(--gutter);
    background: #efe6dc;
    color: #6b4a2f;
    font-size: 0.85rem;
    text-align: center;
  }

  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 32px;
    padding-top: 28px;
    padding-bottom: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--serif);
  }

  .brand-ko {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .brand-hanja {
    font-size: 1rem;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    font-size: 1rem;
    color: var(--muted);
  }

  nav a[aria-current='page'] {
    color: var(--fg);
    font-weight: 600;
  }

  nav a:hover {
    color: var(--seal);
  }

  .site-footer {
    margin-top: 96px;
    padding-top: 24px;
    padding-bottom: 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .site-footer p {
    margin: 0;
  }
</style>
